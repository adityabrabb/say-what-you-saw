# Main AI provider (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Free-tier backup if OpenRouter fails, times out or runs out of credits (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional overrides. The defaults are good.
# Recall's fast path (description -> scene), defaults shown:
# OPENROUTER_FAST_MODEL=google/gemini-2.5-flash-lite
# GEMINI_FAST_MODEL=gemini-flash-lite-latest
# Studio and other long generations, default google/gemini-2.5-flash:
# OPENROUTER_MODEL=
# GEMINI_MODEL=
